# 复制为 config.env 后按需修改（config.env 是个人配置，不要提交到仓库）
#   cp config.env.example config.env
#
# 地址解析优先级：--server 参数 > 环境变量 GLMOCR_URL > 本文件 > 默认 http://127.0.0.1:5010
# 注意：请指向【上传网关 :5010】而不是内置服务 :5002 —— 后者对 PDF 会静默返回空结果。

GLMOCR_URL=http://127.0.0.1:5010

# 服务在别的机器时（本机 DGX Spark 的局域网 / Tailscale 地址）：
# GLMOCR_URL=http://<LAN-IP-2>:5010
# GLMOCR_URL=http://<LAN-IP-1>:5010
# GLMOCR_URL=http://<Tailscale-IP>:5010
